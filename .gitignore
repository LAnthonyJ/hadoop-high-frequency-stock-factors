# ===============================================================
# A clean .gitignore for this SUSTech CS301 Hadoop Project
# ===============================================================

# 1. Build output directories (Generated by Maven and IDEA)
#    These contain compiled .class files and the final .jar file.
target/
out/

# 2. IntelliJ IDEA specific files (User-specific settings)
#    These files change based on your local setup and should not be shared.
.idea/
*.iml
*.iws

# 3. Maven wrapper folder
#    This can be regenerated.
.mvn/

# 4. Operating System generated files (Good practice)
.DS_Store

# 5. Log files (If you generate any)
*.log